# Copier ce fichier en .env (jamais commité) puis adapter.

# Base de développement (docker compose up -d)
DATABASE_URL=postgres://radar:radar@localhost:5432/radar

# Base utilisée par les tests d'intégration : elle est VIDÉE à chaque test.
# Ne jamais y mettre l'URL de la base de production.
TEST_DATABASE_URL=postgres://radar:radar@localhost:5432/radar_test

# Serveur Overpass utilisé par l'import des sentiers.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Production (Supabase) : utiliser la chaîne de connexion du « pooler »
# (Project Settings → Database). À ma connaissance, la connexion directe
# Supabase est en IPv6 uniquement, ce que Render ne gère pas : à vérifier.
